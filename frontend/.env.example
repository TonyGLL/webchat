# ============================================================
# WebChat frontend: plantilla de variables de entorno
#
# Next.js carga estos archivos automáticamente (no se suben a git):
#   .env.local       -> desarrollo en tu máquina (bun dev)
#   .env.production  -> build de producción (bun run build)
#
#   cp .env.example .env.local
#
# Las variables NEXT_PUBLIC_* quedan visibles en el navegador:
# nunca pongas secretos aquí.
# ============================================================

# URL base de la API del backend (incluye /api/v1). El WebSocket usa la misma
# URL cambiando http por ws.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
