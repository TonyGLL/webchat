# ============================================================
# WebChat backend: plantilla de variables de entorno
#
# Copia este archivo según el entorno (los copiados NO se suben a git):
#   .env.local  -> backend en tu máquina (make run / make watch)
#   .env.dev    -> backend dentro de Docker (make up-dev)
#   .env.prod   -> producción (make up-prod)
#
#   cp .env.example .env.local
#
# Los valores de abajo son de ejemplo. Reemplaza todo lo que diga <...>.
# ============================================================

# ---- Servidor ----------------------------------------------
# Puerto HTTP del backend (opcional, por defecto 8081)
PORT=8081

# Entorno: local | dev | prod (con "prod" o "production" se activa modo producción)
APP_ENV=local

# Orígenes permitidos por CORS, separados por comas. Debe incluir el frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3100

# ---- Seguridad ---------------------------------------------
# OBLIGATORIO, mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=<secreto-largo-aleatorio>

# ---- PostgreSQL --------------------------------------------
# Opción A (recomendada): una sola URL. Si se define, se ignoran las DB_*.
# DATABASE_URL=postgres://<usuario>:<clave>@localhost:5433/webchat?sslmode=disable
#
# Opción B: variables sueltas.
#   .env.local  -> DB_HOST=localhost  DB_PORT=5433  (puerto del host)
#   .env.dev/prod (Docker) -> DB_HOST=db  DB_PORT=5432  (red interna)
DB_HOST=localhost
DB_PORT=5433
DB_USER=<usuario>
DB_PASSWORD=<clave>
DB_NAME=webchat

# ---- Redis -------------------------------------------------
# Opción A: una sola URL. Si se define, se ignoran las REDIS_*.
# REDIS_URL=redis://:<clave>@localhost:6380/0
#
# Opción B: variables sueltas.
#   .env.local  -> REDIS_HOST=localhost  REDIS_PORT=6380
#   .env.dev/prod (Docker) -> REDIS_HOST=redis  REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USER=default
REDIS_PASS=<clave>
REDIS_DB=0

# ---- Correo (SMTP) -----------------------------------------
# Solo se usa para el correo de verificación de email.
# Con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
SMTP_HOST=<servidor-smtp>
SMTP_PORT=587
SMTP_FROM=<correo-remitente>
SMTP_PASSWORD=<clave-smtp>
